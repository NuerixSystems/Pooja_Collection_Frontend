# Nuerix CRM tenant for this shop
VITE_TENANT_ID=8
# Backend base URL (required: categories, products, images and orders all come from the backend).
# Local backend:  http://localhost:8000      Deployed backend: https://<your-render-service>.onrender.com
VITE_CRM_API_URL=
# Google OAuth web client ID (must match the ID configured in the Pooja backend).
VITE_GOOGLE_CLIENT_ID=443085550154-qkocvf3f3b2f4gs64h5r13jh3ggaj83p.apps.googleusercontent.com
# Public storefront origin (production defaults to https://poojascollection.com).
VITE_SITE_URL=
